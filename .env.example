# JARVIS's voice is Microsoft Edge TTS — no API key required.
# The edge-tts package is installed via requirements.txt.

# JARVIS's brain is an agent-CLI process running on YOUR subscription/login.
# Default is Claude Code; point JARVIS_CLI_PATH at Hermes Agent to use that
# instead (e.g. JARVIS_CLI_PATH=hermes). No Anthropic API key is needed for
# anything, and any ANTHROPIC_* variable set here is deliberately hidden
# from the brain so it can only use your login.

# Optional: which agent CLI binary the brain and runs spawn.
# Falls back to the `claude` on PATH when unset. Legacy JARVIS_CLAUDE_PATH
# is still honoured.
# JARVIS_CLI_PATH=hermes

# Optional: extra argv appended to every brain/run spawn
# (e.g. hermes toolsets or provider flags).
# JARVIS_CLI_EXTRA_ARGS=

# Optional: Hermes provider override (hermes backend only).
# JARVIS_HERMES_PROVIDER=

# Required for the Hermes backend with the default local proxy: the proxy
# rejects calls without it and Hermes hangs silently. Same key Hermes itself
# uses (its custom provider reads NINEROUTER_API_KEY). Not needed for the
# Claude Code backend.
# NINEROUTER_API_KEY=...

# Optional: Hermes warm-up budget in seconds (default 120; Hermes pays
# ~15-30s of plugin/MCP init per spawn, Claude default is 45).
# JARVIS_BRAIN_WARMUP_TIMEOUT=120

# Optional: per-language Edge TTS voices. Defaults: en-US-GuyNeural,
# id-ID-AndikaNeural, zh-CN-YunjianNeural. E.g. a female Indonesian voice:
# JARVIS_TTS_VOICE_ID=id-ID-GadisNeural

# Optional: which model the brain runs. Default is sonnet on Claude Code,
# kgw/kilo-auto/free on Hermes; always passed explicitly.
# JARVIS_BRAIN_MODEL=sonnet

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Whether to skip CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # or "celsius"

# Optional: reach JARVIS from your phone on the same WiFi. The phone opens
# https://<this-machine's-LAN-IP>:5173 and bypasses the self-signed warning
# once. The IP below must match `hostname -I`; restart after changing.
# JARVIS_ALLOWED_ORIGINS=192.168.1.75
